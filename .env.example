# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These values are not secret: they ship to every browser. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to true to use the local Firebase emulators instead of the real project.
VITE_USE_EMULATORS=false
