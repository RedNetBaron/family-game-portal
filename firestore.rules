rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 30;
    }

    // Invite codes are created by the family admin in the Firebase console.
    // Nobody can list or read them from the app; the rules only check that one exists.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Push tokens, one per phone that turned on notifications (doc id = token).
    // Only the server (admin SDK) reads them to send "your turn" pings.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One document per family member, keyed by their sign-in id.
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'invite', 'joinedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.invite is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
        && request.resource.data.joinedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if false;
    }

    // The single family group chat.
    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'gameId'])
        && (!('gameId' in request.resource.data) || request.resource.data.gameId is string)
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    function validLetterGrid(d) {
      return d.type == 'letterGrid'
        && d.grid is list
        && d['size'] in [4, 5, 6]
        && d.grid.size() == d['size'] * d['size'];
    }

    function validCategoryDash(d) {
      return d.type == 'categoryDash'
        && d.letter is string
        && d.letter.size() == 1
        && d.categories is list
        && d.categories.size() >= 3
        && d.categories.size() <= 12;
    }

    function validTrivia(d) {
      return d.type == 'trivia'
        && d.perQuestion is int
        && d.perQuestion >= 5
        && d.perQuestion <= 60
        && d.questions is list
        && d.questions.size() >= 1
        && d.questions.size() <= 20;
    }

    // Games. Any member can start one; the creator controls the start of a live game.
    match /games/{gameId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.mode in ['live', 'turns']
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 30
        && request.resource.data.seconds <= 1800
        && request.resource.data.createdAt == request.time
        && (validLetterGrid(request.resource.data)
          || validCategoryDash(request.resource.data)
          || validTrivia(request.resource.data));
      // Members may add themselves to the player list.
      allow update: if isMember() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
               .hasOnly([request.auth.uid])
          && request.resource.data.players[request.auth.uid] is string)
        || (resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'startAt', 'endsAt'])));
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;

      function mySubmitted() {
        let mine = /databases/$(database)/documents/games/$(gameId)/plays/$(request.auth.uid);
        return exists(mine) && get(mine).data.submittedAt != null;
      }

      function gameOver() {
        let g = get(/databases/$(database)/documents/games/$(gameId)).data;
        return g.endsAt != null && g.endsAt < request.time;
      }

      // Each player's words. You can see other players' words only after you've
      // finished your own round, or once the game is over.
      match /plays/{uid} {
        allow read: if isMember() && (uid == request.auth.uid || mySubmitted() || gameOver());
        allow create: if isMember()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'words', 'startedAt', 'submittedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.words.size() == 0
          && request.resource.data.startedAt == request.time
          && request.resource.data.submittedAt == null;
        allow update: if isMember()
          && uid == request.auth.uid
          && resource.data.submittedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['words', 'submittedAt'])
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 500
          && (request.resource.data.submittedAt == null || request.resource.data.submittedAt == request.time);
        allow delete: if false;
      }

      // Category Dash: each player's 👎 votes on other players' answers.
      // Readable and writable once your own round is in, or the game is over.
      match /votes/{uid} {
        allow read: if isMember() && (mySubmitted() || gameOver());
        allow write: if isMember()
          && uid == request.auth.uid
          && (mySubmitted() || gameOver())
          && request.resource.data.keys().hasOnly(['rejects'])
          && request.resource.data.rejects is map
          && request.resource.data.rejects.size() <= 200;
      }
    }
  }
}
